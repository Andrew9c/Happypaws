# Copy this file to .env for local use — or, better, paste these directly
# into your hosting provider's "Environment Variables" settings so you never
# have to touch a terminal on your phone.

# From https://dashboard.stripe.com/apikeys (use the "Secret key")
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# From https://dashboard.stripe.com/webhooks after you add an endpoint
# pointing at https://your-app-url/api/webhook (optional but recommended)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Most hosts (Render, Railway) set this automatically — safe to leave blank
PORT=3000
